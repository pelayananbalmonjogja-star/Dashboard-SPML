rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Semua orang boleh BACA file bukti dukung (supaya link-nya bisa dibuka dari dashboard publik).
    // Hanya yang sudah LOGIN (admin) yang boleh UPLOAD/HAPUS file.
    match /buktidukung/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024; // maks 10MB per file
    }
  }
}
